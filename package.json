{
  "name": "sv-itineris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:browser": "playwright test",
    "check": "npm run build && uv run --frozen pytest && npm run test:browser",
    "ci:public": "python3 scripts/public_ci.py push",
    "ci:record": "python3 scripts/public_ci.py prove"
  },
  "dependencies": {
    "@tabler/core": "1.6.1",
    "dompurify": "3.4.17",
    "maplibre-gl": "6.14.0",
    "marked": "18.1.1",
    "terra-draw": "1.31.2",
    "terra-draw-maplibre-gl-adapter": "1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
